<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>All Products</title>

  <style>
    body {
      font-family: Arial;
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    .card {
      border: 1px solid #ccc;
      padding: 15px;
      border-radius: 10px;
      width: 220px;
      text-align: center;
      box-shadow: 2px 2px 10px rgba(0,0,0,0.1);
    }

    img {
      width: 100%;
      height: 150px;
      object-fit: cover;
      border-radius: 8px;
    }

    button {
      margin: 5px;
      padding: 5px 10px;
      cursor: pointer;
    }
  </style>
</head>

<body>

  <% Products.forEach((data)=>{ %>

    <div class="card">
      <img src="<%= data.url %>" alt="product">

      <h3><%= data.P_name %></h3>
      <p>₹ <%= data.P_price %></p>

      <a href="/product/<%= data.P_id %>">
        <button>Show</button>
      </a>

      <a href="/product/<%= data.P_id %>/edit">
        <button>Edit</button>
      </a>

      <form action="/product/<%= data.P_id %>?_method=DELETE" method="POST">
        <button type="submit">Delete</button>
      </form>
    </div>

  <% }) %>

</body>
</html>