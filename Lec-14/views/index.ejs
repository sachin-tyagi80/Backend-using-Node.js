<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>List all Product</title>
</head>
<body>
  <article>
    <% Products.map((data)=>{ %>
      <img src="<%= data.url%>" alt="" height="">
      <h1>Name : <%= data.P_name%></h1>
      <h3>Price : <%= data.P_price%></h3>
      <aside>
        <button></button>
      </aside>

    <% }) %>
  </article>
  
</body>
</html>